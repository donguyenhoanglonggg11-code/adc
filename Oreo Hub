-- ========== TOGGLE HELPER ==========
local function makeToggle(parent, label, default, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 36)
    container.BackgroundTransparency = 1
    container.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(235, 235, 245)
    lbl.TextSize = 16
    lbl.Font = Enum.Font.Arial
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.Parent = container

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 65, 0, 26)
    btn.Position = UDim2.new(1, -70, 0.5, -13)
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.ArialBold
    btn.BackgroundColor3 = default and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(200, 60, 60)
    btn.BorderSizePixel = 0
    btn.Parent = container
    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 4)
    bc.Parent = btn

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(200, 60, 60)
        if callback then callback(state) end
    end)
    return function() return state end
end

-- ========== SLIDER HELPER ==========
local function makeSlider(parent, label, minV, maxV, defaultV, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 48)
    container.BackgroundTransparency = 1
    container.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0.4, 0)
    lbl.Text = label .. "  " .. tostring(defaultV) .. "s"
    lbl.TextColor3 = Color3.fromRGB(235, 235, 245)
    lbl.TextSize = 16
    lbl.Font = Enum.Font.Arial
    lbl.BackgroundTransparency = 1
    lbl.Parent = container

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 0.25, 0)
    bg.Position = UDim2.new(0, 0, 0.6, 0)
    bg.BackgroundColor3 = Color3.fromRGB(70, 70, 95)
    bg.BorderSizePixel = 0
    bg.Parent = container
    local bgc = Instance.new("UICorner")
    bgc.CornerRadius = UDim.new(0, 4)
    bgc.Parent = bg

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((defaultV - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bg
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(0, 4)
    fc.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new((defaultV - minV) / (maxV - minV), -8, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = bg
    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(0, 8)
    kc.Parent = knob

    local value = defaultV
    local dragging = false

    local function update(input)
        local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        value = minV + (maxV - minV) * pos
        value = math.round(value * 10) / 10
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -8, 0.5, -8)
        lbl.Text = label .. "  " .. tostring(value) .. "s"
        if callback then callback(value) end
    end

    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)
    bg.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    bg.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)

    return function() return value end
end

