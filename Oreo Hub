-- ========== CORE LOOPS ==========
local clickThread, afkThread
local clickRunning = false
local afkRunning = false

local function clickLoop()
    while clickRunning do
        if autoState then
            doClick()
            if lagState then wait(intervalVal) else wait(intervalVal) end
        else
            wait(0.1)
        end
    end
end

local function afkLoop()
    while afkRunning do
        if afkState then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            end)
            wait(5)
        else
            wait(0.5)
        end
    end
end

RunService.Heartbeat:Connect(function()
    if autoState and not clickThread then
        clickRunning = true
        clickThread = coroutine.create(clickLoop)
        coroutine.resume(clickThread)
    elseif not autoState and clickThread then
        clickRunning = false
        clickThread = nil
    end

    if afkState and not afkThread then
        afkRunning = true
        afkThread = coroutine.create(afkLoop)
        coroutine.resume(afkThread)
    elseif not afkState and afkThread then
        afkRunning = false
        afkThread = nil
    end
end)

-- ========== DRAG ==========
local drag = false
local dragStart, startPos
main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        drag = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then drag = false end
        end)
    end
end)
main.InputChanged:Connect(function(input)
    if drag and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

