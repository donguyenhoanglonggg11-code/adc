genBtn.MouseButton1Click:Connect(function()
    local secret = secretBox.Text
    local dur    = durationBox.Text
    local cnt    = tonumber(countBox.Text) or 1

    if secret == "" or dur == "" then
        creatorStatus.Text = "⚠️ Fill in secret + duration!"
        creatorStatus.TextColor3 = C.Danger
        return
    end
    if not CREATOR_SECRETS[secret] then
        creatorStatus.Text = "❌ Invalid creator secret!"
        creatorStatus.TextColor3 = C.Danger
        return
    end
    local secs = ParseDuration(dur)
    if not secs then
        creatorStatus.Text = "❌ Bad duration. Use 1h / 30p / 2d / 7m"
        creatorStatus.TextColor3 = C.Danger
        return
    end

    cnt = math.clamp(cnt, 1, CONFIG.MAX_KEYS_PER_BATCH)

    local generated = {}
    for _ = 1, cnt do
        local key = GenerateKey()
        KeyStore[key] = {
            duration  = secs,
            used      = false,
            created   = os.time(),
            createdBy = Player.Name,
        }
        table.insert(generated, key)
    end
    SaveKeys()

    creatorStatus.Text = "✅ Generated " .. cnt .. " key(s) for " .. FormatRemaining(secs) .. " each"
    creatorStatus.TextColor3 = C.Success

    local txt = table.concat(generated, "\n")
    pcall(function()
        if setclipboard then setclipboard(txt) end
    end)
    Notify("Keys Generated ⭐", cnt .. " key(s) copied to clipboard!", "vip", 6)

    keyOutputLbl.Text = txt
    keyOutputBox.CanvasSize = UDim2.new(0, 0, 0, #generated * 16 + 20)
end)

