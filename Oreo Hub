-- ===== HÀM CLICK (không tele) =====
local function PerformClick()
    local success, err = pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.03)
        VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    if not success then
        pcall(function() mouse1click() end)
    end
end

-- ===== HÀM TELE VỀ VỊ TRÍ ĐÃ LƯU =====
local function TeleportToSaved()
    if not TeleStartPos then
        print("⚠️ [Oreo] Chưa có vị trí lưu. Hãy bật Auto Tele hoặc dùng 'Lưu vị trí'.")
        return false
    end
    local char = Player.Character
    if not char then
        print("❌ [Oreo] Không tìm thấy nhân vật.")
        return false
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        print("❌ [Oreo] Không tìm thấy HumanoidRootPart.")
        return false
    end
    
    -- Thử tele CFrame
    local success, err = pcall(function()
        hrp.CFrame = CFrame.new(TeleStartPos + Vector3.new(0, 2, 0))
    end)
    if success then
        print("✅ [Oreo] Tele về vị trí: " .. tostring(TeleStartPos))
        return true
    else
        print("❌ [Oreo] Tele thất bại: " .. tostring(err) .. " → thử dùng MoveTo")
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:MoveTo(TeleStartPos)
            return true
        end
        return false
    end
end

-- ===== HÀM LƯU VỊ TRÍ HIỆN TẠI =====
local function SaveCurrentPosition()
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        print("❌ [Oreo] Không thể lưu vị trí – nhân vật chưa sẵn sàng.")
        return false
    end
    TeleStartPos = char.HumanoidRootPart.Position
    print("📍 [Oreo] Đã lưu vị trí: " .. tostring(TeleStartPos))
    return true
end

