            page.Visible = true
            page.Position = UDim2.new(0, 10, 0, 0)
            Tween(page, 0.35, {Position = UDim2.new(0, 0, 0, 0)})
        else
            page.Visible = false
        end
    end
    for n, btn in pairs(TabButtons) do
        local on = (n == name)
        Tween(btn, 0.22, {
            BackgroundColor3 = on and C.Primary or C.GlassLo,
            TextColor3       = on and Color3.new(1, 1, 1) or C.SubText,
