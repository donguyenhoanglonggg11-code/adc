UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.T then
        local newState = not State.AutoClick
        if ToggleRefs.autoClick then ToggleRefs.autoClick(newState) end
        State.AutoClick = newState
        if newState then
            State.ClickCancelled = false
            Notify("Hotkey T", "Auto Click ON", "success")
            if State.ClickLoop then State.ClickLoop:Disconnect() end
            State.ClickLoop = RunService.Heartbeat:Connect(function()
                if not State.AutoClick then
                    if State.ClickLoop then
                        State.ClickLoop:Disconnect()
                        State.ClickLoop = nil
                    end
                    return
                end
                if State.AutoFarm then return end
                if CanClick() then PerformClick() end
            end)
        else
            Notify("Hotkey T", "Auto Click OFF", "warn")
            if State.ClickLoop then State.ClickLoop:Disconnect(); State.ClickLoop = nil end
        end
    end

    if input.KeyCode == Enum.KeyCode.Y then
        TeleportToSaved()
    end

    if input.KeyCode == Enum.KeyCode.U then
        local newState = not State.AutoTele
        if ToggleRefs.autoTele then ToggleRefs.autoTele(newState) end
        State.AutoTele = newState
        if newState then
            if SavePosition() then
                Notify("Hotkey U", "Auto Tele ON", "success")
                State.AutoClickTimer = 0
                if State.TeleLoop then State.TeleLoop:Disconnect() end
                State.TeleLoop = RunService.Heartbeat:Connect(function(dt)
                    if not State.AutoTele then
                        if State.TeleLoop then
                            State.TeleLoop:Disconnect()
                            State.TeleLoop = nil
                        end
                        return
                    end
                    State.AutoClickTimer += dt
                    if State.AutoClickTimer >= State.TeleInterval then
                        State.AutoClickTimer = 0
                        TeleportToSaved()
                    end
                end)
            end
        else
            Notify("Hotkey U", "Auto Tele OFF", "warn")
            if State.TeleLoop then State.TeleLoop:Disconnect(); State.TeleLoop = nil end
        end
    end

    if input.KeyCode == Enum.KeyCode.G then
        local newState = not State.FastGraphics
        if ToggleRefs.fastGraphics then ToggleRefs.fastGraphics(newState) end
        State.FastGraphics = newState
        ApplyFastGraphics(newState)
    end

    if input.KeyCode == Enum.KeyCode.F2 then
        if State.AutoFarm then
            StopAutoFarm(true)
        else
            Notify("Hotkey F2", "Auto Farm is not active", "warn")
        end
    end

    if input.KeyCode == Enum.KeyCode.RightControl then
        SetMenuVisible(not State.MenuVisible)
    end
end)

