local function FindNearestStake(maxDist)
    maxDist = maxDist or 3000
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil, nil end

    local myPos = char.HumanoidRootPart.Position
    local npcFolder = workspace:FindFirstChild(CONFIG.FARM_NPC_FOLDER)
    if not npcFolder then return nil, nil end

    local bestPart, bestModel, bestDist = nil, nil, maxDist
    for _, obj in ipairs(npcFolder:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find(CONFIG.FARM_STAKE_KEYWORD) then
            local root = obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("Torso")
                or obj:FindFirstChildWhichIsA("BasePart", true)
            if root then
                local d = (root.Position - myPos).Magnitude
                if d < bestDist then
                    bestDist, bestPart, bestModel = d, root, obj
                end
            end
        elseif obj:IsA("BasePart") and obj.Name:lower():find(CONFIG.FARM_STAKE_KEYWORD) then
            local d = (obj.Position - myPos).Magnitude
            if d < bestDist then
                bestDist, bestPart = d, obj
                bestModel = obj:FindFirstAncestorOfClass("Model") or obj
            end
        end
    end
    return bestPart, bestModel
end

