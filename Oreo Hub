-- 1. Nút Auto Click (chỉ click, không tele)
local AutoClickBtn = Instance.new("TextButton")
AutoClickBtn.Size = UDim2.new(0, 220, 0, 40)
AutoClickBtn.Position = UDim2.new(0.5, -110, 0, 10)
AutoClickBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
AutoClickBtn.Text = "❌ Auto Click: OFF"
AutoClickBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AutoClickBtn.TextScaled = true
AutoClickBtn.Font = Enum.Font.Gotham
AutoClickBtn.BorderSizePixel = 0
AutoClickBtn.Parent = mainContent

local function ToggleAutoClick()
    AutoClickEnabled = not AutoClickEnabled
    if AutoClickEnabled then
        AutoClickBtn.Text = "✅ Auto Click: ON"
        AutoClickBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        print("🔄 [Oreo] Bật Auto Click (không tele)")
        if ClickLoop then ClickLoop:Disconnect() end
        ClickLoop = RunService.Heartbeat:Connect(function()
            if AutoClickEnabled then
                PerformClick()
            else
                ClickLoop:Disconnect()
                ClickLoop = nil
            end
        end)
    else
        AutoClickBtn.Text = "❌ Auto Click: OFF"
        AutoClickBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
        if ClickLoop then ClickLoop:Disconnect(); ClickLoop = nil end
        print("⛔ [Oreo] Tắt Auto Click")
    end
end
AutoClickBtn.MouseButton1Click:Connect(ToggleAutoClick)

-- 2. Nút Auto Tele (tự động tele sau 60s)
local AutoTeleBtn = Instance.new("TextButton")
AutoTeleBtn.Size = UDim2.new(0, 220, 0, 40)
AutoTeleBtn.Position = UDim2.new(0.5, -110, 0, 60)
AutoTeleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
AutoTeleBtn.Text = "⏳ Auto Tele (60s): OFF"
AutoTeleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AutoTeleBtn.TextScaled = true
AutoTeleBtn.Font = Enum.Font.Gotham
AutoTeleBtn.BorderSizePixel = 0
AutoTeleBtn.Parent = mainContent

local function ToggleAutoTele()
    AutoTeleEnabled = not AutoTeleEnabled
    if AutoTeleEnabled then
        -- Lưu vị trí hiện tại khi bật
        if not SaveCurrentPosition() then
            AutoTeleEnabled = false
            AutoTeleBtn.Text = "⏳ Auto Tele (60s): OFF"
            AutoTeleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
            return
        end
        AutoTeleBtn.Text = "✅ Auto Tele (60s): ON"
        AutoTeleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        AutoClickTimer = 0
        print("🔄 [Oreo] Bật Auto Tele, sẽ tele sau 60 giây")
        if TeleLoop then TeleLoop:Disconnect() end
        TeleLoop = RunService.Heartbeat:Connect(function(deltaTime)
            if not AutoTeleEnabled then
                TeleLoop:Disconnect()
                TeleLoop = nil
                return
            end
            AutoClickTimer = AutoClickTimer + deltaTime
            if AutoClickTimer >= TELEPORT_INTERVAL then
                AutoClickTimer = 0
                TeleportToSaved()
            end
        end)
    else
        AutoTeleBtn.Text = "⏳ Auto Tele (60s): OFF"
        AutoTeleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
        if TeleLoop then TeleLoop:Disconnect(); TeleLoop = nil end
        print("⛔ [Oreo] Tắt Auto Tele")
        -- Không xóa vị trí đã lưu để dùng cho nút Tele ngay
    end
end
AutoTeleBtn.MouseButton1Click:Connect(ToggleAutoTele)

