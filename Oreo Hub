-- ===== CORE LOOPS =====
local clickRunning, afkRunning = false, false
local clickThread, afkThread

local function clickLoop()
    while clickRunning do
        if autoState then
            performClick()
            if lagState then wait(intervalVal) else wait(intervalVal) end
        else
            wait(0.1)
        end
    end
end

local function afkLoop()
    while afkRunning do
        if afkState then
            antiAfkAction()
            wait(10)
        else
            wait(0.5)
        end
    end
end

RunService.Heartbeat:Connect(function()
    if autoState and not clickThread then
        clickRunning = true
        clickThread = coroutine.create(clickLoop)
        coroutine.resume(clickThread)
    elseif not autoState and clickThread then
        clickRunning = false
        clickThread = nil
    end

    if afkState and not afkThread then
        afkRunning = true
        afkThread = coroutine.create(afkLoop)
        coroutine.resume(afkThread)
    elseif not afkState and afkThread then
        afkRunning = false
        afkThread = nil
    end
end)

