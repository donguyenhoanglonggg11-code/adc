local function MakeSlider(parent, yPos, min, max, default, onChange)
    local track = Make("Frame", {
        Size             = UDim2.new(1, -28, 0, 6),
        Position         = UDim2.new(0, 14, 0, yPos),
        BackgroundColor3 = C.GlassLo,
        BorderSizePixel  = 0,
        Parent           = parent,
    })
    Corner(track, 3)

    local fill = Make("Frame", {
        Size             = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.Primary,
        BorderSizePixel  = 0,
        Parent           = track,
    })
    Corner(fill, 3)
    Gradient(fill, C.Primary, C.Accent, 0)

    local knob = Make("Frame", {
        Size             = UDim2.new(0, 16, 0, 16),
        Position         = UDim2.new(fill.Size.X.Scale, -8, 0.5, -8),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel  = 0,
        Parent           = track,
    })
    Corner(knob, 8)
    Stroke(knob, C.Primary, 2, 0)

    local dragging = false
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * rel
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -8, 0.5, -8)
        if onChange then onChange(val) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

