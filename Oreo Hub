local function LockAndStick()
    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    if not State.FarmStake or not State.FarmStake.Parent then
        local part, model = FindNearestStake()
        if not part then
            Notify("Auto Farm", "No " .. CONFIG.FARM_STAKE_KEYWORD .. " found in workspace." .. CONFIG.FARM_NPC_FOLDER, "error")
            return false
        end
        State.FarmStake       = part
        State.FarmStakeModel  = model
        State.FarmLockedStake = model
        Notify("Auto Farm", "🔒 Locked: " .. (model and model.Name or part.Name), "success")
    end

    local stakePos  = State.FarmStake.Position
    local targetPos = stakePos + Vector3.new(0, 2, 2)

    local ok = pcall(function()
        hrp.CFrame = CFrame.lookAt(targetPos, stakePos + Vector3.new(0, 1, 0))
        hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
    return ok
end

function StartAutoFarm()
    if State.AutoFarm then return end
    State.AutoFarm = true
    State.FarmTimer = 0
    State.FarmTeleTimer = 0
    State.FarmStake = nil
    State.FarmStakeModel = nil
    State.FarmLockedStake = nil
    State.ClickCancelled = false
    State.StopCooldown = 0    if ToggleRefs.autoFarm then ToggleRefs.autoFarm(true) end
    if not LockAndStick() then
        State.AutoFarm = false
        if ToggleRefs.autoFarm then ToggleRefs.autoFarm(false) end
        return
    end

    Notify("Auto Farm", "Started — locked to nearest log", "success")
    ShowStickyFarmNotif()
    ShowFarmHUD()

    -- Continuous click loop
    if State.FarmClickLoop then State.FarmClickLoop:Disconnect() end
    State.FarmClickLoop = RunService.Heartbeat:Connect(function()
        if not State.AutoFarm then return end
        if CanClick() then PerformClick() end
    end)

    -- Aim + lock loop
    if State.FarmAimLoop then State.FarmAimLoop:Disconnect() end
    State.FarmAimLoop = RunService.Heartbeat:Connect(function()
        if not State.AutoFarm then return end
        local char = Player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp then return end

        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum:Move(Vector3.new(0, 0, 0), false)
        end

        if State.FarmLockedStake and State.FarmLockedStake.Parent then
            local part = State.FarmStake
            if part and part.Parent then
                local stakePos  = part.Position
                local targetPos = stakePos + Vector3.new(0, 2, 2)
                pcall(function()
                    hrp.CFrame = CFrame.lookAt(targetPos, stakePos + Vector3.new(0, 1, 0))
                    hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        else
            task.defer(function()
                Notify("Auto Farm", "Stake removed — stopping", "warn")
                StopAutoFarm(false)
            end)
        end
    end)

    -- Teleport back to stake every N seconds
    if State.FarmTeleLoop then State.FarmTeleLoop:Disconnect() end
    State.FarmTeleLoop = RunService.Heartbeat:Connect(function(dt)
        if not State.AutoFarm then return end
        State.FarmTeleTimer += dt
        if State.FarmTeleTimer >= CONFIG.FARM_TELE_INTERVAL then
            State.FarmTeleTimer = 0
            local char = Player.Character
            if char and State.FarmStake and State.FarmStake.Parent then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local stakePos  = State.FarmStake.Position
                    local targetPos = stakePos + Vector3.new(0, 2, 2)
                    pcall(function()
                        hrp.CFrame = CFrame.lookAt(targetPos, stakePos + Vector3.new(0, 1, 0))
                    end)
                end
            end
        end
    end)

    -- Live HUD updates
    task.spawn(function()
        while State.AutoFarm do
            task.wait(0.1)
            State.FarmTimer += 0.1
            if FarmTimeLbl and FarmTimeLbl.Parent then
                FarmTimeLbl.Text = FormatTime(State.FarmTimer)
            end
            if FarmNextTeleLbl and FarmNextTeleLbl.Parent then
                local left = CONFIG.FARM_TELE_INTERVAL - State.FarmTeleTimer
                FarmNextTeleLbl.Text = string.format("%ds", math.max(0, math.floor(left)))
            end
            if _G.FarmHUDInfoLbl and _G.FarmHUDInfoLbl.Parent then
                local name = State.FarmStakeModel and State.FarmStakeModel.Name or "???"
                _G.FarmHUDInfoLbl.Text = "🎯 Target: " .. name
            end
        end
    end)
end

function StopAutoFarm(respawn)
    if not State.AutoFarm then return end

    -- Cancel any in-flight click BEFORE touching anything else
    State.ClickCancelled = true
    State.AutoFarm = false
    State.StopCooldown = os.clock() + 0.2

    if ToggleRefs.autoFarm then ToggleRefs.autoFarm(false) end

    -- Also kill the regular Auto Click if it was active
    if State.AutoClick then
        State.AutoClick = false
        if ToggleRefs.autoClick then ToggleRefs.autoClick(false) end
    end

    if State.FarmClickLoop then State.FarmClickLoop:Disconnect(); State.FarmClickLoop = nil end
    if State.FarmAimLoop   then State.FarmAimLoop:Disconnect();   State.FarmAimLoop   = nil end
    if State.FarmTeleLoop  then State.FarmTeleLoop:Disconnect();  State.FarmTeleLoop  = nil end
    if State.ClickLoop     then State.ClickLoop:Disconnect();     State.ClickLoop     = nil end

    local char = Player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
    end

    State.FarmStake       = nil
    State.FarmStakeModel  = nil
    State.FarmLockedStake = nil

    HideStickyFarmNotif()
    HideFarmHUD()
    Notify("Auto Farm", "Stopped — Time: " .. FormatTime(State.FarmTimer), "warn")

    -- Release any stuck mouse button
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)

    task.delay(0.25, function()
        State.ClickCancelled = false
    end)

    if respawn then
        task.wait(0.2)
        local c = Player.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then
                h.Health = 0
                Notify("Respawn", "Respawning character...", "info")
            end
        end
    end
end

