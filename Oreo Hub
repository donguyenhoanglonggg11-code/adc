        v.Visible = (k == name)
        tabButtons[k].BackgroundColor3 = (k == name) and Color3.fromRGB(80, 80, 120) or Color3.fromRGB(60, 60, 80)
        tabButtons[k].TextColor3 = (k == name) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
