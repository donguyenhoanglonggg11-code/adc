-- ===================== FPS COUNTER =====================
local fpsCounter = { current = 0, frameCount = 0, lastTime = tick() }

local function updateFPS()
    fpsCounter.frameCount = fpsCounter.frameCount + 1
    local now = tick()
    if now - fpsCounter.lastTime >= 1 then
        fpsCounter.current = fpsCounter.frameCount
        fpsCounter.frameCount = 0
        fpsCounter.lastTime = now
    end
end
RunService.Heartbeat:Connect(updateFPS)

-- ===================== CLICK =====================
local function performClick()
    local success = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    if success then return true end
    if mouse1click then pcall(mouse1click); return true end
    pcall(function()
        local args = {Enum.UserInputState.Begin, Enum.KeyCode.Button1, Vector2.new(mouse.X, mouse.Y)}
        game:GetService("ContextActionService"):FireInputEvent(args)
        args[1] = Enum.UserInputState.End
        game:GetService("ContextActionService"):FireInputEvent(args)
    end)
    return true
end

-- ===================== ANTI-AFK =====================
local function antiAfkAction()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
        wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    end)
    pcall(function()
        local x, y = UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y
        VirtualInputManager:SendMouseMovementEvent(x + 1, y + 1, 0, game)
        wait(0.02)
        VirtualInputManager:SendMouseMovementEvent(x, y, 0, game)
    end)
end

